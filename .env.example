# Export these in the shell or configure them in the hosting platform.
# This app does not automatically read .env files.
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Use a fresh random secret when hosting. Local setup has an assessment-only default.
SECRET_KEY=replace-for-hosting
TRUST_PROXY=false
SECURE_SSL_REDIRECT=false
OSRM_URL=https://router.project-osrm.org
WEATHER_URL=https://api.open-meteo.com/v1/forecast

{
  "name": "weather-aware-truck-routing-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && node --experimental-strip-types --test src/router.test.ts",
    "build:frontend": "npm --prefix ../frontend run build",
    "dev": "wrangler dev",
    "deploy": "npm run check && npm run build:frontend && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --containers-rollout=none --outdir ../output/cloudflare",
    "dry-run": "wrangler deploy --dry-run --outdir ../output/cloudflare"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.150.0"
  }
}
